# ==============================================================================
# Neural Arbiter — Environment Variables Configuration
# ==============================================================================

# Master Toggle:
# Set to 'false' to enable live LLM and DuckDuckGo API calls.
# Set to 'true' to run entirely in mock/test mode without consuming API quota.
TEST_MODE=true

# Google AI Studio API Key (Required for Agent A & Primary Judge — Gemini 2.5 Flash)
# Get a free key: https://aistudio.google.com/
GOOGLE_API_KEY=your_google_ai_studio_key_here

# Groq Cloud API Key (Required for Agent B & Fallback Judge — Llama 3.1 8B Instant)
# Get a free key: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Anthropic API Key (Optional — for Claude debater integration)
# https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here
